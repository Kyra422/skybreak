// INSTALL19: resources for @SB_TARGET@ (generated from res/app.rc.in by CMake).
#include <winver.h>
1 ICON "@SB_ICON@"
@SB_LOGO_LINE@
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SB_V1@,@SB_V2@,@SB_V3@,0
 PRODUCTVERSION @SB_V1@,@SB_V2@,@SB_V3@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "SkyBreak (fanproject)"
      VALUE "FileDescription", "@SB_DESC@"
      VALUE "FileVersion", "@SB_VERSION@"
      VALUE "InternalName", "@SB_TARGET@"
      VALUE "LegalCopyright", "Non-commercial fan project, not affiliated with or endorsed by Nintendo. Based on NWiiRecomp by Volodymyr Vovchok (BlackLine Interactive)."
      VALUE "OriginalFilename", "@SB_TARGET@.exe"
      VALUE "ProductName", "SkyBreak"
      VALUE "ProductVersion", "@SB_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
